# SSL desativado porque e um Postgres local.
DATABASE_URL=postgres://postgres:qb8wbE1ONSgHyqj7SHBnGNhMVD6G9Z4tdY7ghOh1UyIfviFpdC@postgres:5432/attendee_db
POSTGRES_SSL_REQUIRE=false

# ---- Postgres externo (nao usado pelo compose, apenas documentacao) ----
POSTGRES_DB=attendee_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=qb8wbE1ONSgHyqj7SHBnGNhMVD6G9Z4tdY7ghOh1UyIfviFpdC

# ---- Redis (do proprio compose) ----
REDIS_URL=redis://attendee-redis-1:6379/5

# ---- Storage: Backblaze B2 (compativel com S3) ----
# keyID e applicationKey do B2 viram AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# Endpoint no formato https://<bucket>.s3.<region>.backblazeb2.com .
AWS_ACCESS_KEY_ID=00529d17cac00460000000003
AWS_SECRET_ACCESS_KEY=K0059G8Oilw6vntcHcBR6PAAtI1LbbA
AWS_DEFAULT_REGION=us-east-005
AWS_RECORDING_STORAGE_BUCKET_NAME=attendee.sintesy
AWS_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com

# ---- HTTPS / cookies seguros ----
# Rodando localmente sem HTTPS; defina como true se colocar behind reverse proxy TLS.
DJANGO_SSL_REQUIRE=false

# ---- Modo de lancamento de bots ----
# docker-compose-multi-host: bot_launcher cria containers efemeros via Docker socket
LAUNCH_BOT_METHOD=docker-compose-multi-host

# Imagem usada pelos containers efemeros dos bots (nome da imagem buildada pelo compose):
BOT_CONTAINER_IMAGE=attendee-attendee-app-local:latest
# Caminho absoluto NO HOST onde o codigo esta montado (o launcher bind-mount no bot):
BOT_HOST_CODE_PATH=/root/attendee

# Limites de recurso por bot efemero:
BOT_MEMORY_LIMIT=2g
BOT_CPU_QUOTA=100000
BOT_CPU_PERIOD=100000
BOT_MAX_EXECUTION_SECONDS=14400
BOT_MAX_SIMULTANEOUS_BOTS=100
# Manter containers apos fim p/ debugar logs:
BOT_CONTAINER_AUTO_REMOVE=true
# Nome da rede Docker do compose que os bots efemeros devem entrar
# (deve bater com o nome da rede definida em docker-compose.bots.yaml):
BOT_CONTAINER_NETWORK=shared

# ---- Chrome sandbox (bots web / Google Meet) ----
ENABLE_CHROME_SANDBOX=false

# ---- Webhooks / Rate limiting ----
REQUIRE_HTTPS_WEBHOOKS=false
DISABLE_RATE_LIMITING=false

# ---- Email (desabilitado; confirmacao de conta vai p/ log do server) ----
DISABLE_EMAIL=true

