DJANGO_SECRET_KEY=UMbP138ULvHQC_HKyigZG5hzDA3GbA-oYPUChkfvx68BY6tpxiNJIN9afA3j0b_8hDs
CREDENTIALS_ENCRYPTION_KEY=KjjPWPqinHaIOTeTCF70zGnFwFqTh3ByDj9AMr3kQ8M=

# ---- Settings de producao ----
DJANGO_SETTINGS_MODULE=attendee.settings.production
TIME_ZONE=UTC
SITE_DOMAIN=meeting.sintesy.me
ALLOWED_HOSTS=localhost,attendee-app,meeting.sintesy.me,*

# ---- Banco de dados (Postgres EXTERNO - container "postgres" na porta 5432 do host) ----
